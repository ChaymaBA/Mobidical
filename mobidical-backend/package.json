{
  "name": "mobidical-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
      "build": "tsc",
      "start": "nodemon",
      "start:development": "ENV_FILE=./config/.env.development.local npm run start",
      "start:staging": "ENV_FILE=./config/env.staging.local npm run start",
      "start:beta": "ENV_FILE=./config/.env.beta.local npm run start",
      "start:prod": "ENV_FILE=./config/env.production npm run start",
      "lint": "eslint 'src/**/*.{js,ts}' --fix",
      "test": "vitest run",
      "test:ui": "vitest --ui --coverage.enabled=true",
      "test:types": "tsc --noEmit",
      "docker-build:development": "sh ./scripts/docker-build.sh development",
      "docker-build:staging": "sh ./scripts/docker-build.sh staging",
      "docker-build:production": "sh ./scripts/docker-build.sh production",
      "docker:migrate": "sh ./scripts/docker-migrate.sh",
      "typeorm": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js",
      "migration:generate": "npm run typeorm migration:generate -- -d src/core/configuration/data-source.ts",
      "migration:run": "npm run typeorm migration:run -- -d ./src/core/configuration/data-source.ts",
      "migration:revert": "npm run typeorm migration:revert -- -d ./src/core/configuration/data-source.ts",
      "migration:sync": "npm run typeorm schema:sync -- -d ./src/core/configuration/data-source.ts",
      "migration:show": "npm run typeorm migration:show -- -d ./src/core/configuration/data-source.ts",
      "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
      "bcrypt": "^5.1.1",
      "class-transformer": "^0.5.1",
      "class-validator": "^0.14.1",
      "compression": "^1.7.5",
      "cors": "^2.8.5",
      "crypto": "^1.0.1",
      "dotenv": "^16.4.5",
      "express": "^4.21.1",
      "express-brute": "^1.0.1",
      "express-rate-limit": "^7.4.1",
      "express-session": "^1.18.1",
      "express-winston": "^4.2.0",
      "helmet": "^8.0.0",
      "helmet-csp": "^4.0.0",
      "hpp": "^0.2.3",
      "joi": "^17.13.3",
      "jsonwebtoken": "^9.0.2",
      "morgan": "^1.10.0",
      "pg": "^8.13.1",
      "reflect-metadata": "^0.2.2",
      "swagger-ui-express": "^5.0.1",
      "typeorm": "^0.3.20",
      "validator": "^13.12.0",
      "winston": "^3.16.0",
      "xss": "^1.0.15",
      "yamljs": "^0.3.0",
      "zod": "^3.23.8"
    },
    "devDependencies": {
      "@types/bcrypt": "^5.0.2",
      "@types/cors": "^2.8.17",
      "@types/express": "^5.0.0",
      "@types/jsonwebtoken": "^9.0.7",
      "@types/node": "^22.9.0",
      "@types/supertest": "^6.0.2",
      "@typescript-eslint/eslint-plugin": "^8.13.0",
      "@typescript-eslint/parser": "^8.13.0",
      "@vitest/coverage-v8": "^2.1.4",
      "@vitest/ui": "^2.1.4",
      "eslint": "^9.15.0",
      "eslint-config-prettier": "^9.1.0",
      "eslint-import-resolver-typescript": "^3.6.3",
      "eslint-plugin-import": "^2.31.0",
      "eslint-plugin-node": "^11.1.0",
      "eslint-plugin-prettier": "^5.2.1",
      "husky": "^9.1.7",
      "lint-staged": "^15.2.10",
      "nodemon": "^3.1.7",
      "supertest": "^7.0.0",
      "ts-node": "^10.9.2",
      "tsconfig-paths": "^4.2.0",
      "typescript": "^5.6.3",
      "vitest": "^2.1.4"
    },
    "nodemonConfig": {
      "watch": [
        "src"
      ],
      "ext": ".ts,.js",
      "ignore": ["node_modules",
        "src/**/*.spec.ts"
      ],
      "exec": "ts-node -r tsconfig-paths/register src/index.ts"
    }
}
